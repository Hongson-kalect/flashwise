# Địa chỉ backend flashwise_api (xem docs/APP_INTEGRATION.md)
# Android emulator: http://10.0.2.2:8000 | điện thoại thật: http://<IP LAN>:8000
EXPO_PUBLIC_API_ORIGIN=http://10.0.2.2:8000

# Đăng nhập Google: để trống thì ẩn nút Google.
# Web client id (loại "Web application") trong Google Cloud Console; backend phải có cùng id trong GOOGLE_CLIENT_IDS.
# Android cần thêm OAuth client loại Android: package com.hongson197201.flashwise + SHA-1 của keystore.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# Ảnh minh hoạ tạm phía app khi nghĩa chưa có ảnh từ server. Có key Pixabay thì dùng Pixabay,
# để trống thì tự dùng Wikimedia Commons (không cần key).
EXPO_PUBLIC_PIXABAY_API_KEY=
